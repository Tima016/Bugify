# Bugify Docker Environment Variables
# Copy this file to .env in the project root

# --- PostgreSQL ---
POSTGRES_USER=bugify
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=bugify

# --- Redis ---
REDIS_PASSWORD=change_me_strong_redis_password

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_minio_password

# --- JWT ---
JWT_SECRET=change_me_long_random_secret_at_least_64_chars

# --- Frontend URL (used for CORS and cookie domain) ---
FRONTEND_URL=http://localhost

<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 10px 10px 0 0;
        }

        .content {
            background: #f9f9f9;
            padding: 30px;
            border-radius: 0 0 10px 10px;
        }

        .button {
            display: inline-block;
            padding: 12px 30px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 20px 0;
        }

        .approved {
            background: #d4edda;
            border-left: 4px solid #28a745;
            padding: 15px;
            margin: 20px 0;
        }

        .rejected {
            background: #f8d7da;
            border-left: 4px solid #dc3545;
            padding: 15px;
            margin: 20px 0;
        }

        .footer {
            text-align: center;
            margin-top: 30px;
            color: #666;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>KYC Verification Update</h1>
        </div>
        <div class="content">
            <p>Hello {{name}},</p>
            {{#if (eq status 'APPROVED')}}
            <div class="approved">
                <h2>✅ KYC Approved</h2>
                <p>Your identity verification has been successfully approved! You now have full access to all platform
                    features.</p>
            </div>
            {{else}}
            <div class="rejected">
                <h2>❌ KYC Rejected</h2>
                <p>Unfortunately, we were unable to verify your identity at this time.</p>
                {{#if notes}}
                <p><strong>Reason:</strong> {{notes}}</p>
                {{/if}}
                <p>Please resubmit your documents with the correct information.</p>
            </div>
            {{/if}}
            <p style="text-align: center;">
                <a href="{{dashboardUrl}}" class="button">Go to Dashboard</a>
            </p>
            <p>If you have any questions, please contact our support team.</p>
            <p><strong>The UzSecure Team</strong></p>
        </div>
        <div class="footer">
            <p>&copy; 2024 UzSecure. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
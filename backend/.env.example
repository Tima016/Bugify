# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uzsecure"

# JWT Configuration
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@uzsecure.uz"

# S3/MinIO Storage
S3_ENDPOINT="http://localhost:9000"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="uzsecure-uploads"

# File Upload Limits
MAX_FILE_SIZE=52428800

# Elasticsearch
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="changeme"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Application
NODE_ENV="development"
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# UzCard Payment Configuration
UZCARD_MERCHANT_ID="your-uzcard-merchant-id"
UZCARD_SECRET_KEY="your-uzcard-secret-key"

# Humo Payment Configuration
HUMO_MERCHANT_ID="your-humo-merchant-id"
HUMO_SECRET_KEY="your-humo-secret-key"

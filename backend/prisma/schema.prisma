// UzSecure Bug Bounty Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  username                String    @unique
  passwordHash            String
  firstName               String?
  lastName                String?
  phoneNumber             String?
  countryCode             String    @default("UZ")
  profilePictureUrl       String?
  bio                     String?
  role                    UserRole  @default(RESEARCHER)
  reputationScore         Int       @default(0)
  totalEarnings           Decimal   @default(0) @db.Decimal(10, 2)
  currentBalance          Decimal   @default(0) @db.Decimal(10, 2)
  isVerified              Boolean   @default(false)
  isEmailVerified         Boolean   @default(false)
  isPhoneVerified         Boolean   @default(false)
  isBanned                Boolean   @default(false)
  banReason               String?
  kycStatus               KycStatus @default(NOT_SUBMITTED)
  kycDocuments            Json?
  twoFactorEnabled        Boolean   @default(false)
  twoFactorSecret         String?
  backupCodes             Json?
  preferredLanguage       String    @default("uz")
  timezone                String    @default("Asia/Tashkent")
  notificationPreferences Json?
  socialLinks             Json?
  skills                  String[]
  certifications          Json?
  lastLoginAt             DateTime?
  lastActiveAt            DateTime?
  riskScore               Int       @default(0)
  riskLevel               RiskLevel @default(LOW)
  riskLockedAt            DateTime?
  riskOverrideBy          String?
  riskOverrideAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  // Relations
  companyId              String?
  company                Company?           @relation(fields: [companyId], references: [id])
  reports                Report[]           @relation("ResearcherReports")
  comments               Comment[]
  payments               Payment[]          @relation("ResearcherPayments")
  notifications          Notification[]
  auditLogs              AuditLog[]
  payoutRequests         PayoutRequest[]
  managedPrograms        Program[]          @relation("ProgramManager")
  invitationCodesCreated InvitationCode[]   @relation("InvitationCodesCreated")
  leaderboardEntries     LeaderboardEntry[]
  achievements           Achievement[]
  webhooks               Webhook[]
  statusTransitions      ReportStatusTransition[] @relation("StatusTransitions")
  programInvitesReceived ProgramInvite[]     @relation("ProgramInvites")
  programInvitesCreated  ProgramInvite[]     @relation("ProgramInvitesCreated")

  @@index([email])
  @@index([username])
  @@index([companyId])
  @@index([role, createdAt])  // Composite: admin user queries
  @@map("users")
}

// Company Model
model Company {
  id                    String             @id @default(uuid())
  companyName           String             @unique
  legalName             String
  taxId                 String?            @unique
  stripeCustomerId      String?            @unique
  websiteUrl            String?
  industry              String?
  companySize           CompanySize?
  logoUrl               String?
  description           String?
  headquartersLocation  String?
  foundedYear           Int?
  verificationStatus    VerificationStatus @default(PENDING)
  verificationDocuments Json?
  billingEmail          String?
  supportEmail          String?
  securityEmail         String?
  paymentMethod         Json?
  subscriptionPlan      SubscriptionPlan   @default(BASIC)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  totalPrograms         Int                @default(0)
  totalPaidOut          Decimal            @default(0) @db.Decimal(12, 2)
  averageResponseTime   Int?
  domainVerifyToken     String?
  domainVerifyStatus    DomainVerifyStatus @default(UNVERIFIED)
  domainVerifiedAt      DateTime?
  onboardingRiskScore   Int?               @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?          // Soft delete

  // Relations
  users           User[]
  programs        Program[]
  payments        Payment[]        @relation("CompanyPayments")
  invoices        Invoice[]
  invitationCodes InvitationCode[]

  @@index([verificationStatus])
  @@map("companies")
}

// Invoice Model
model Invoice {
  id        String        @id @default(uuid())
  companyId String
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(DRAFT)
  dueDate   DateTime
  paidAt    DateTime?
  items     Json // Line items (e.g., "Bounty for Report #123")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
  OVERDUE
}

// Program Model
model Program {
  id                    String           @id @default(uuid())
  companyId             String
  programName           String
  slug                  String           @unique
  description           String
  programType           ProgramType      @default(PUBLIC)
  status                ProgramStatus    @default(ACTIVE)
  launchDate            DateTime         @default(now())
  scope                 Json
  outOfScope            Json?
  targetTypes           String[]
  vulnerabilityTypes    String[]
  responseEfficiency    Json?
  rulesAndGuidelines    String?
  safeHarborPolicy      String?
  disclosurePolicy      DisclosurePolicy @default(LIMITED)
  disclosureTimeline    Int?
  rewardStructure       Json?
  minimumPayout         Decimal          @default(0) @db.Decimal(10, 2)
  maximumPayout         Decimal          @db.Decimal(10, 2)
  currency              String           @default("USD")
  averagePayout         Decimal?         @db.Decimal(10, 2)
  hallOfFameEnabled     Boolean          @default(true)
  swagRewardsAvailable  Boolean          @default(false)
  totalReportsReceived  Int              @default(0)
  totalValidReports     Int              @default(0)
  totalPaidOut          Decimal          @default(0) @db.Decimal(12, 2)
  averageTriageTime     Int?
  averageResolutionTime Int?
  researcherRating      Decimal?         @db.Decimal(2, 1)
  managedBy             String?
  teamMembers           Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?        // Soft delete

  // Relations
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?    @relation("ProgramManager", fields: [managedBy], references: [id])
  reports Report[]
  invites ProgramInvite[]

  @@index([companyId])
  @@index([slug])
  @@index([status])
  @@index([companyId, status])  // Composite: company dashboard queries
  @@map("programs")
}

// Report Model
model Report {
  id                     String        @id @default(uuid())
  reportNumber           String        @unique
  programId              String
  researcherId           String
  title                  String
  vulnerabilityType      String
  severity               Severity
  cvssScore              Decimal?      @db.Decimal(3, 1)
  cvssVector             String?
  description            String
  impactAnalysis         String
  reproductionSteps      String
  proofOfConcept         String?
  attachments            Json?
  affectedAssets         Json?
  discoveredDate         DateTime
  submittedDate          DateTime      @default(now())
  status                 ReportStatus  @default(NEW)
  triageStatus           TriageStatus  @default(PENDING)
  priority               Priority?
  bountyAmount           Decimal?      @db.Decimal(10, 2)
  bonusAmount            Decimal?      @db.Decimal(10, 2)
  paymentStatus          PaymentStatus @default(PENDING)
  paymentDate            DateTime?
  assignedTo             String?
  collaborators          Json?
  isDisclosed            Boolean       @default(false)
  disclosedAt            DateTime?
  publicDisclosureUrl    String?
  duplicateOf            String?
  weaknessCwe            String?
  weaknessOwasp          String?
  retestRequested        Boolean       @default(false)
  retestStatus           RetestStatus?
  researcherImpactRating Int?
  companyImpactRating    Int?
  timeToTriage           Int?
  timeToResolution       Int?
  timeToBounty           Int?
  internalNotes          String?
  tags                   String[]
  customFields           Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  resolvedAt             DateTime?
  deletedAt              DateTime?     // Soft delete

  // Relations
  program           Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  researcher        User                   @relation("ResearcherReports", fields: [researcherId], references: [id])
  comments          Comment[]
  payments          Payment[]
  statusTransitions ReportStatusTransition[]

  @@index([programId])
  @@index([researcherId])
  @@index([status])
  @@index([severity])
  @@index([reportNumber])
  @@index([programId, status, severity])  // Composite: program dashboard queries
  @@index([researcherId, createdAt])      // Composite: researcher history
  @@map("reports")
}

// Comment Model
model Comment {
  id              String            @id @default(uuid())
  reportId        String
  userId          String
  parentCommentId String?
  content         String
  attachments     Json?
  isInternal      Boolean           @default(false)
  visibility      CommentVisibility @default(PUBLIC)
  edited          Boolean           @default(false)
  editedAt        DateTime?
  reactions       Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Relations
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentReplies")

  @@index([reportId])
  @@index([userId])
  @@map("comments")
}

// Payment Model
model Payment {
  id             String        @id @default(uuid())
  reportId       String
  researcherId   String
  companyId      String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  amountInUzs    Decimal?      @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  paymentDetails Json?
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @unique
  invoiceNumber  String?       @unique
  invoiceUrl     String?
  taxWithheld    Decimal?      @db.Decimal(10, 2)
  feeAmount      Decimal?      @db.Decimal(10, 2)
  netAmount      Decimal?      @db.Decimal(10, 2)
  initiatedBy    String?
  approvedBy     String?
  paidAt         DateTime?
  failureReason  String?
  retryCount     Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  report     Report  @relation(fields: [reportId], references: [id])
  researcher User    @relation("ResearcherPayments", fields: [researcherId], references: [id])
  company    Company @relation("CompanyPayments", fields: [companyId], references: [id])

  @@index([reportId])
  @@index([researcherId])
  @@index([companyId])
  @@index([status])
  @@map("payments")
}

// Notification Model
model Notification {
  id           String               @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  link         String?
  metadata     Json?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  priority     NotificationPriority @default(NORMAL)
  channel      NotificationChannel  @default(IN_APP)
  sentViaEmail Boolean              @default(false)
  sentViaSms   Boolean              @default(false)
  createdAt    DateTime             @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// AuditLog Model
model AuditLog {
  id           String      @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  changes      Json?
  severity     LogSeverity @default(INFO)
  success      Boolean     @default(true)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

// Enums
enum UserRole {
  RESEARCHER
  COMPANY
  ADMIN
  MODERATOR
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionPlan {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  SUSPENDED
}

enum ProgramType {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ProgramStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum DisclosurePolicy {
  FULL
  LIMITED
  NONE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum ReportStatus {
  NEW
  TRIAGED
  NEEDS_MORE_INFO
  ACCEPTED
  DUPLICATE
  INFORMATIVE
  NOT_APPLICABLE
  RESOLVED
  CLOSED
}

enum TriageStatus {
  PENDING
  TRIAGED
  RETESTING
}

enum Priority {
  P0
  P1
  P2
  P3
  P4
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  APPROVED
  PAID
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYPAL
  CRYPTOCURRENCY
  UZCARD
  HUMO
}

enum RetestStatus {
  PENDING
  PASSED
  FAILED
}

enum CommentVisibility {
  PUBLIC
  TEAM_ONLY
  ADMINS_ONLY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// PayoutRequest Model
model PayoutRequest {
  id             String        @id @default(uuid())
  researcherId   String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  destination    Json
  status         PayoutStatus  @default(PENDING)
  transactionRef String?
  processedAt    DateTime?
  processedBy    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  researcher User @relation(fields: [researcherId], references: [id])
  approvals  PayoutApproval[]

  @@map("payout_requests")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// InvitationCode Model
model InvitationCode {
  id          String    @id @default(uuid())
  code        String    @unique
  companyId   String
  email       String?
  role        UserRole  @default(RESEARCHER)
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("InvitationCodesCreated", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([code])
  @@map("invitation_codes")
}

// LeaderboardEntry Model (Persistent)
model LeaderboardEntry {
  id              String   @id @default(uuid())
  userId          String
  rank            Int
  reputationScore Int
  totalEarnings   Decimal  @db.Decimal(10, 2)
  validReports    Int
  period          String // e.g., "2024-01", "2024-Q1", "all-time"
  calculatedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, period])
  @@index([period, rank])
  @@map("leaderboard_entries")
}

// Achievement Model
model Achievement {
  id          String   @id @default(uuid())
  userId      String
  type        String // e.g., "FIRST_BLOOD", "CRITICAL_HUNTER", "STREAK_7"
  title       String
  description String
  iconUrl     String?
  earnedAt    DateTime @default(now())
  metadata    Json?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("achievements")
}

// Webhook Model
model Webhook {
  id        String   @id @default(uuid())
  userId    String
  url       String
  events    String[] // e.g., ["report.created", "payment.completed"]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id])
  logs WebhookLog[]

  @@index([userId])
  @@map("webhooks")
}

// WebhookLog Model
model WebhookLog {
  id          String   @id @default(uuid())
  webhookId   String
  event       String
  payload     Json
  response    Json?
  statusCode  Int?
  success     Boolean
  error       String?
  attemptedAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@map("webhook_logs")
}

// ============================================
// Report Status Transition — Audit Trail
// Tracks every status change with who, when, and why
// ============================================
model ReportStatusTransition {
  id          String       @id @default(uuid())
  reportId    String
  oldStatus   ReportStatus
  newStatus   ReportStatus
  changedBy   String       // userId of who changed it
  reason      String?      // Optional justification
  metadata    Json?        // Additional context (e.g., bounty amount on ACCEPTED)
  createdAt   DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation("StatusTransitions", fields: [changedBy], references: [id])

  @@index([reportId])
  @@index([changedBy])
  @@index([reportId, createdAt])
  @@map("report_status_transitions")
}

// ============================================
// Ledger Entry — Double-Entry Financial Accounting
// Every financial operation creates exactly TWO entries:
// a DEBIT from one account and a CREDIT to another.
// ============================================
model LedgerEntry {
  id              String     @id @default(uuid())
  transactionId   String     // Groups debit+credit pair (UUID)
  accountId       String     // e.g., "escrow", "user_wallet:{userId}", "platform_fees"
  type            LedgerType
  amount          Decimal    @db.Decimal(12, 2)
  currency        String     @default("USD")
  referenceType   String     // e.g., "REPORT_PAYOUT", "PAYOUT_REQUEST", "FEE"
  referenceId     String     // ID of the related entity (reportId, payoutRequestId)
  description     String?
  balanceAfter    Decimal?   @db.Decimal(12, 2) // Running balance snapshot
  createdBy       String?    // userId or "system"
  createdAt       DateTime   @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([referenceId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

enum LedgerType {
  DEBIT
  CREDIT
}

// ============================================
// Program Invite — Private program access control
// ============================================
model ProgramInvite {
  id            String              @id @default(uuid())
  programId     String
  researcherId  String?
  email         String?
  invitedBy     String
  status        ProgramInviteStatus @default(PENDING)
  expiresAt     DateTime?
  acceptedAt    DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  program    Program @relation(fields: [programId], references: [id])
  researcher User?   @relation("ProgramInvites", fields: [researcherId], references: [id])
  inviter    User    @relation("ProgramInvitesCreated", fields: [invitedBy], references: [id])

  @@unique([programId, researcherId])
  @@unique([programId, email])
  @@index([researcherId])
  @@index([programId, status])
  @@map("program_invites")
}

enum ProgramInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ============================================
// Payout Approval — Dual-admin approval for high-value payouts
// ============================================
model PayoutApproval {
  id         String   @id @default(uuid())
  payoutId   String
  approvedBy String
  createdAt  DateTime @default(now())

  payout PayoutRequest @relation(fields: [payoutId], references: [id])

  @@unique([payoutId, approvedBy])
  @@index([payoutId])
  @@map("payout_approvals")
}

// ============================================
// Security Alert — Fraud detection & incident tracking
// ============================================
model SecurityAlert {
  id           String         @id @default(uuid())
  category     AlertCategory
  severity     AlertSeverity
  title        String
  description  String
  targetUserId String?        // User being flagged (if applicable)
  sourceIp     String?
  metadata     Json?          // Signal-specific data (scores, evidence)
  status       AlertStatus    @default(OPEN)
  resolvedBy   String?
  resolvedAt   DateTime?
  cooldownKey  String?        // Dedup key for cooldown logic
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([severity])
  @@index([category])
  @@index([targetUserId])
  @@index([status, severity])
  @@index([cooldownKey, createdAt])
  @@map("security_alerts")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertCategory {
  MULTI_ACCOUNT
  FAKE_FARMING
  LEADERBOARD_MANIPULATION
  PAYMENT_FRAUD
  INSIDER_THREAT
  BRUTEFORCE
  MALWARE
  RATE_LIMIT_ABUSE
  GRAPHQL_ABUSE
  SYSTEM
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DomainVerifyStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}
